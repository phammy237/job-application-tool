{
  "name": "career-os",
  "private": true,
  "version": "0.1.0",
  "description": "Career OS — privacy-first job application assistant. Monorepo root.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@career-os/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@career-os/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "discovery:sync": "vite-node scripts/discovery/sync.ts",
    "discovery:import-sources": "vite-node scripts/discovery/import-sources.ts",
    "discovery:extract-features": "vite-node scripts/discovery/extract-features.ts",
    "discovery:enrich-jobright": "vite-node scripts/discovery/enrich-jobright.ts",
    "discovery:resolve-postings": "vite-node scripts/discovery/resolve-official-postings.ts",
    "discovery:rank": "vite-node scripts/discovery/rank.ts",
    "discovery:set-profile": "vite-node scripts/discovery/set-profile.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "supabase": "^2.111.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 90,
    "tabWidth": 2,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
