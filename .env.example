# Career OS — environment variables
#
# Copy to apps/web/.env.local for local development. Never commit a real .env file.
# See docs/DEPLOYMENT.md §4 and docs/SECURITY_AND_PRIVACY.md §3 for handling rules.

# --- Supabase (Career OS's own project — never share with mypham.space) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client, never import outside
# packages/database's admin client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (server-only; wired up starting Phase 3, packages/ai) ---
ANTHROPIC_API_KEY=

# --- Google OAuth / Gmail (server-only; wired up starting Phase 5, packages/email) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server-only. Used to encrypt Gmail refresh tokens at rest
# (email_connections.encrypted_refresh_token). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- App config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Chrome extension (Phase 2) ---
# The extension's ID, derived from the "key" pinned in apps/extension/manifest.config.ts — not
# a secret, just needs to match so /extension-connect's chrome.runtime.sendMessage targets the
# right extension. Get it from chrome://extensions after loading the unpacked build.
NEXT_PUBLIC_EXTENSION_ID=
